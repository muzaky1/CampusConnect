# Copy to .env.local and fill in your real credentials.
# .env.local is git-ignored — never commit real passwords.
# After editing, restart Expo with: npx expo start -c

# Your dev backend (used by the other screens, not by SMS).
EXPO_PUBLIC_API_URL=http://10.221.102.172:3000

# KudiSMS new platform (my.kudisms.net) token API endpoint.
EXPO_PUBLIC_KUDISMS_API_URL=https://my.kudisms.net/api/sms

# KudiSMS API token (Dashboard > Developers > API Key).
EXPO_PUBLIC_KUDISMS_TOKEN=your-kudisms-token

# Gateway: 2 = promotional (refunds DND, DND numbers don't deliver).
EXPO_PUBLIC_KUDISMS_GATEWAY=2

# Approved sender ID (e.g. CampConnect, max 11 chars). Must be approved in
# your my.kudisms.net dashboard or messages will be rejected.
EXPO_PUBLIC_KUDISMS_SENDER_ID=CampConnect
