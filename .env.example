# Copy to .env.local and fill in your real credentials.
# .env.local is git-ignored — never commit real passwords.
# After editing, restart Expo with: npx expo start -c

# Your dev backend (used by the other screens, not by SMS).
EXPO_PUBLIC_API_URL=http://10.221.102.172:3000

# KudiSMS classic HTTP API endpoint. Leave the default unless
# KudiSMS support gives you a different URL.
EXPO_PUBLIC_KUDISMS_API_URL=https://account.kudisms.net/api/

# KudiSMS account username (the one you log in with).
EXPO_PUBLIC_KUDISMS_USERNAME=your-kudisms-username

# KudiSMS account password.
EXPO_PUBLIC_KUDISMS_PASSWORD=your-kudisms-password

# Approved sender ID (e.g. CampusConnect). Must be approved in
# your KudiSMS dashboard or messages will be rejected.
EXPO_PUBLIC_KUDISMS_SENDER_ID=CampusConnect
