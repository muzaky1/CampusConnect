{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/node_modules/**": "deny"
    },
    "glob": {
      "*": "allow",
      ".env*": "deny",
      "**/.env*": "deny"
    },
    "grep": {
      "*": "allow",
      ".env*": "deny",
      "**/.env*": "deny"
    },
    "bash": {
      "*": "allow",
      "cat *env*": "deny",
      "cat *.env*": "deny",
      "Get-Content *env*": "deny",
      "type *env*": "deny",
      "git checkout*": "ask",
      "git push*": "ask",
      "git push --force*": "deny",
      "git reset --hard*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "rm *": "ask",
      "rm -rf*": "deny",
      "rmdir*": "ask",
      "chmod*": "deny",
      "chown*": "deny",
      "sudo *": "deny",
      "curl *": "ask",
      "docker*": "ask"
    },
    "webfetch": "ask",
    "external_directory": "ask"
  }
}